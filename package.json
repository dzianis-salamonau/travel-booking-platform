{
  "name": "travel-booking-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @travel/backend exec prisma generate",
    "db:migrate": "pnpm --filter @travel/backend exec prisma migrate dev",
    "db:seed": "pnpm --filter @travel/backend exec prisma db seed",
    "db:push": "pnpm --filter @travel/backend exec prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
